#!/usr/bin/env sh

# nnn opener script (adapted from nnn's nuke plugin)
# Configured for Wayland/Hyprland:
#   - Images:    imv (opens directory starting at selected image)
#   - Video:     mpv
#   - Documents: zathura (PDF, EPUB, XPS, DjVu, PS, CBZ/CBR)
#   - Audio:     cmus (plays via cmus-remote; launches cmus in footclient if needed)
#   - Text/Code: vim ($VISUAL / $EDITOR)
#   - Archives:  atool / bsdtar / 7z / unrar -> $PAGER

GUI="${GUI:-1}"
BIN="${BIN:-0}"

set -euf -o noclobber -o noglob -o nounset
IFS="$(printf '%b_' '\n')"; IFS="${IFS%_}"

PATH="$PATH:${XDG_CONFIG_HOME:-$HOME/.config}/nnn/plugins"

FPATH="$1"
FNAME="$(basename -- "$1")"
EDITOR="${VISUAL:-${EDITOR:-vim}}"
PAGER="${PAGER:-less -R}"
TERMINAL="${TERMINAL:-footclient}"

case "$FNAME" in
    *.*) ext="$(printf "%s" "${FNAME##*.}" | tr '[:upper:]' '[:lower:]')" ;;
    *)   ext="" ;;
esac

abspath() {
    if command -v realpath >/dev/null 2>&1; then
        abs_target="$(realpath -s -- "$1")"
    else
        case "$1" in
            /*) abs_target="$1" ;;
            *)  abs_target="$PWD/$1" ;;
        esac
    fi
}

detach() {
    if command -v setsid >/dev/null 2>&1; then
        setsid -f "$@" </dev/null >/dev/null 2>&1
    else
        nohup "$@" </dev/null >/dev/null 2>&1 &
    fi
}

launch_cmus() {
    case "$TERMINAL" in
        footclient)
            footclient -N -T cmus cmus >/dev/null 2>&1 || detach foot -T cmus cmus
            ;;
        foot)
            detach foot -T cmus cmus
            ;;
        kitty|gnome-terminal|st)
            detach "$TERMINAL" -- cmus
            ;;
        *)
            detach "$TERMINAL" -e cmus
            ;;
    esac

    i=0
    while ! cmus-remote -C >/dev/null 2>&1; do
        i=$((i + 1))
        [ "$i" -ge 30 ] && return 1
        sleep 0.1
    done
}

handle_pdf() {
    if [ "$GUI" -ne 0 ] && command -v zathura >/dev/null 2>&1; then
        detach zathura -- "${FPATH}"
    elif command -v pdftotext >/dev/null 2>&1; then
        pdftotext -l 10 -nopgbrk -q -- "${FPATH}" - | eval "$PAGER"
    elif command -v mutool >/dev/null 2>&1; then
        mutool draw -F txt -i -- "${FPATH}" 1-10 | eval "$PAGER"
    elif command -v exiftool >/dev/null 2>&1; then
        exiftool "${FPATH}" | eval "$PAGER"
    else
        return
    fi
    exit 0
}

handle_audio() {
    abspath "${FPATH}"
    if command -v cmus >/dev/null 2>&1 && command -v cmus-remote >/dev/null 2>&1; then
        if ! cmus-remote -C >/dev/null 2>&1; then
            launch_cmus || return
        fi
        cmus-remote -f "$abs_target" >/dev/null 2>&1
    elif command -v mpv >/dev/null 2>&1; then
        detach mpv -- "${FPATH}"
    elif command -v mediainfo >/dev/null 2>&1; then
        mediainfo "${FPATH}" | eval "$PAGER"
    elif command -v exiftool >/dev/null 2>&1; then
        exiftool "${FPATH}" | eval "$PAGER"
    else
        return
    fi
    exit 0
}

handle_video() {
    if [ "$GUI" -ne 0 ] && command -v mpv >/dev/null 2>&1; then
        detach mpv -- "${FPATH}"
    elif command -v mediainfo >/dev/null 2>&1; then
        mediainfo "${FPATH}" | eval "$PAGER"
    elif command -v exiftool >/dev/null 2>&1; then
        exiftool "${FPATH}" | eval "$PAGER"
    else
        return
    fi
    exit 0
}

handle_image() {
    abspath "${FPATH}"
    if [ "$GUI" -ne 0 ]; then
        viewer=""
        if command -v imv >/dev/null 2>&1; then
            viewer="imv"
        elif command -v imv-wayland >/dev/null 2>&1; then
            viewer="imv-wayland"
        elif command -v nsxiv >/dev/null 2>&1; then
            viewer="nsxiv"
        elif command -v sxiv >/dev/null 2>&1; then
            viewer="sxiv"
        fi

        if [ -n "$viewer" ]; then
            dir="${abs_target%/*}"
            dir="${dir:-/}"
            tmp="${TMPDIR:-/tmp}/nuke_img_$$"
            trap 'rm -f -- "$tmp"' EXIT

            find -L "$dir" -maxdepth 1 -type f -print0 2>/dev/null \
                | grep -izZE '\.(jpe?g|png|gif|webp|tiff?|bmp|ico|svg|avif|jxl|heic|heif)$' \
                | sort -zV > "$tmp" || true

            count="$(grep -a -m 1 -ZzxnF "$abs_target" "$tmp" | cut -d: -f1 || true)"
            if [ -n "$count" ]; then
                if command -v setsid >/dev/null 2>&1; then
                    xargs -0 setsid -f "$viewer" -n "$count" -- < "$tmp" >/dev/null 2>&1
                else
                    xargs -0 nohup "$viewer" -n "$count" -- < "$tmp" >/dev/null 2>&1 &
                fi
            else
                detach "$viewer" -- "$abs_target"
            fi
            exit 0
        fi
    fi

    if command -v exiftool >/dev/null 2>&1; then
        exiftool "${FPATH}" | eval "$PAGER"
        exit 0
    fi
}

handle_extension() {
    case "${ext}" in
        a|ace|alz|arc|arj|bz|bz2|cab|cpio|deb|gz|jar|lha|lz|lzh|lzma|lzo|\
        rpm|rz|t7z|tar|tbz|tbz2|tgz|tlz|txz|tZ|tzo|war|xpi|xz|Z|zip|zst)
            if command -v atool >/dev/null 2>&1; then
                atool --list -- "${FPATH}" | eval "$PAGER"
                exit 0
            elif command -v bsdtar >/dev/null 2>&1; then
                bsdtar --list --file "${FPATH}" | eval "$PAGER"
                exit 0
            fi
            exit 1 ;;
        rar)
            if command -v unrar >/dev/null 2>&1; then
                unrar lt -p- -- "${FPATH}" | eval "$PAGER"
                exit 0
            fi
            exit 1 ;;
        7z)
            if command -v 7z >/dev/null 2>&1; then
                7z l -p -- "${FPATH}" | eval "$PAGER"
                exit 0
            fi
            exit 1 ;;

        pdf|epub|djvu|xps|oxps|ps|cbz|cbr)
            handle_pdf ;;

        aac|aiff|alac|ape|flac|m4a|mid|midi|mpa|mp2|mp3|ogg|opus|wav|wma|wv)
            handle_audio ;;

        avi|flv|m2ts|m4v|mkv|mov|mp4|mpeg|mpg|ogv|ts|webm|wmv)
            handle_video ;;

        avif|bmp|gif|heic|heif|ico|jpeg|jpg|jxl|png|svg|tif|tiff|webp)
            handle_image ;;

        log|md|txt|conf|ini|json|toml|yaml|yml|lua|sh|zsh|bash)
            "$EDITOR" "${FPATH}"
            exit 0 ;;
    esac
}

handle_multimedia() {
    case "$1" in
        image/vnd.djvu)
            handle_pdf ;;
        image/*)
            handle_image ;;
        application/pdf|application/epub+zip|application/postscript|\
        application/oxps|application/vnd.ms-xpsdocument)
            handle_pdf ;;
        audio/*)
            handle_audio ;;
        video/*)
            handle_video ;;
    esac
}

handle_mime() {
    case "$1" in
        text/troff)
            man -l "${FPATH}"
            exit 0 ;;
        text/*|*/xml|application/json|application/javascript|application/toml|\
        application/yaml|application/x-yaml|inode/x-empty)
            "$EDITOR" "${FPATH}"
            exit 0 ;;
    esac
}

handle_blocked() {
    case "$1" in
        application/x-sharedlib|application/x-shared-library-la|\
        application/x-executable|application/x-shellscript|\
        application/octet-stream)
            exit 0 ;;
    esac
}

handle_bin() {
    case "$1" in
        application/x-executable|application/x-shellscript)
            clear
            echo '-------- Executable File --------'
            file --dereference --brief -- "${FPATH}"
            printf "Run executable (y/N/'a'rgs)? "
            read -r answer
            case "$answer" in
                [Yy]*) exec "${FPATH}" ;;
                [Aa]*)
                    printf "args: "
                    read -r args
                    # shellcheck disable=SC2086
                    exec "${FPATH}" $args ;;
                *) exit 0 ;;
            esac ;;
    esac
}

handle_fallback() {
    if [ "$GUI" -ne 0 ] && command -v xdg-open >/dev/null 2>&1; then
        detach xdg-open "${FPATH}"
        exit 0
    fi
    echo '----- File details -----'
    file --dereference --brief -- "${FPATH}"
    exit 1
}

handle_extension
MIMETYPE="$(file -bL --mime-type -- "${FPATH}")"
handle_multimedia "${MIMETYPE}"
handle_mime "${MIMETYPE}"
[ "$BIN" -ne 0 ] && [ -x "${FPATH}" ] && handle_bin "${MIMETYPE}"
handle_blocked "${MIMETYPE}"
handle_fallback
