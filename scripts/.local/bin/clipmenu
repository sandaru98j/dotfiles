#!/usr/bin/env bash
# clipmenu — Minimal clipboard history picker (cliphist + fuzzel + wl-copy)

set -euo pipefail

if ! command -v cliphist >/dev/null 2>&1; then
    notify-send -a "clipmenu" "cliphist not installed" "Run: sudo pacman -S cliphist" 2>/dev/null || true
    exit 1
fi

selection="$(cliphist list | fuzzel --dmenu --prompt='󰅌 ' --lines=12 --width=60)" || exit 0
[[ -n "$selection" ]] || exit 0

printf '%s\n' "$selection" | cliphist decode | wl-copy
