#!/usr/bin/env bash
# theme-switch — Instant live theme switcher (Nord <-> Dracula)
# Syncs: Hyprland borders, Waybar, Kitty, Fuzzel, Mako, and Hyprpaper.

set -euo pipefail

STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/theme-switch"
STATE_FILE="$STATE_DIR/current"
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
WALL_BASE="$HOME/Pictures/wallpapers"

mkdir -p "$STATE_DIR"

current_theme() {
    if [[ -f "$STATE_FILE" ]]; then
        cat "$STATE_FILE"
    else
        echo "nord"
    fi
}

CURRENT="$(current_theme)"

case "${1:-toggle}" in
    toggle)
        if [[ "$CURRENT" == "nord" ]]; then
            TARGET="dracula"
        else
            TARGET="nord"
        fi
        ;;
    nord|dracula)
        TARGET="$1"
        ;;
    status)
        echo "$CURRENT"
        exit 0
        ;;
    *)
        echo "Usage: $(basename "$0") [toggle|nord|dracula|status]" >&2
        exit 1
        ;;
esac

if [[ "$TARGET" == "nord" ]]; then
    LABEL="Nord"
    HYPR_ACTIVE="rgba(88c0d0ff)"
    HYPR_INACTIVE="rgba(3b4252ff)"
    HYPR_BG="rgb(2e3440)"
    DEFAULT_WALL="$WALL_BASE/nord/arctic-landscape.png"
else
    LABEL="Dracula"
    HYPR_ACTIVE="rgba(bd93f9ff)"
    HYPR_INACTIVE="rgba(44475aff)"
    HYPR_BG="rgb(282a36)"
    DEFAULT_WALL="$WALL_BASE/dracula/base.png"
fi

# Resolve wallpaper (fall back to first image in theme dir if default missing)
WALLPAPER="$DEFAULT_WALL"
if [[ ! -f "$WALLPAPER" ]]; then
    WALLPAPER="$(find "$WALL_BASE/$TARGET" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \) 2>/dev/null | sort | head -n 1 || true)"
fi

# 1. Persist state
printf '%s\n' "$TARGET" > "$STATE_FILE"

# 2. Hyprland (persistent Lua theme + live border update)
ln -sfn "$CONF_DIR/hypr/themes/$TARGET.lua" "$CONF_DIR/hypr/theme.lua"
if command -v hyprctl >/dev/null 2>&1 && hyprctl instances >/dev/null 2>&1; then
    hyprctl eval "hl.config({ general = { col = { active_border = '$HYPR_ACTIVE', inactive_border = '$HYPR_INACTIVE' } }, misc = { background_color = '$HYPR_BG' } })" \
        >/dev/null 2>&1 || hyprctl reload config-only >/dev/null 2>&1 || true
fi

# 3. Waybar (symlink palette + live CSS reload via SIGUSR2)
ln -sfn "$CONF_DIR/waybar/themes/$TARGET.css" "$CONF_DIR/waybar/colors.css"
if pgrep -x waybar >/dev/null 2>&1; then
    pkill -SIGUSR2 -x waybar || true
fi

# 4. Kitty (symlink palette + live reload via SIGUSR1)
ln -sfn "$CONF_DIR/kitty/themes/$TARGET.conf" "$CONF_DIR/kitty/theme.conf"
if pgrep -x kitty >/dev/null 2>&1; then
    pkill -SIGUSR1 -x kitty || true
fi

# 5. Fuzzel (symlink palette — applied on next launch)
ln -sfn "$CONF_DIR/fuzzel/themes/$TARGET.ini" "$CONF_DIR/fuzzel/theme.ini"

# 6. Mako (symlink config + live reload via makoctl)
ln -sfn "$CONF_DIR/mako/themes/$TARGET" "$CONF_DIR/mako/config"
if pgrep -x mako >/dev/null 2>&1 && command -v makoctl >/dev/null 2>&1; then
    makoctl reload >/dev/null 2>&1 || true
fi

# 7. Hyprpaper (persist hyprpaper.conf + live IPC switch)
if [[ -n "$WALLPAPER" && -f "$WALLPAPER" ]]; then
    cat > "$CONF_DIR/hypr/hyprpaper.conf" <<EOF
# Hyprpaper Configuration (v0.8+ block syntax)
# Wallpaper path is synced automatically by ~/.local/bin/theme-switch

splash = false
ipc = true

wallpaper {
    monitor =
    path = $WALLPAPER
    fit_mode = cover
}
EOF
    if pgrep -x hyprpaper >/dev/null 2>&1 && command -v hyprctl >/dev/null 2>&1; then
        hyprctl hyprpaper wallpaper ", $WALLPAPER, cover" >/dev/null 2>&1 || true
    fi
fi

# 8. Notify user if notify-send is available
if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "theme-switch" -t 2500 "Theme: $LABEL" "Switched Hyprland, Waybar, Kitty, Fuzzel, Mako & Wallpaper" 2>/dev/null || true
fi
