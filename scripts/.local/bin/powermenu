#!/usr/bin/env bash
# powermenu — Minimal Fuzzel power menu (Lock / Suspend / Logout / Reboot / Poweroff)

set -euo pipefail

choice="$(printf '%s\n' \
    '󰌾  Lock' \
    '󰤄  Suspend' \
    '󰍃  Logout' \
    '󰜉  Reboot' \
    '󰐥  Poweroff' \
    | fuzzel --dmenu --prompt='⏻ ' --lines=5 --width=22)" || exit 0

case "$choice" in
    *Lock)
        if command -v hyprlock >/dev/null 2>&1; then
            exec hyprlock
        elif command -v loginctl >/dev/null 2>&1; then
            exec loginctl lock-session
        fi
        ;;
    *Suspend)
        exec systemctl suspend
        ;;
    *Logout)
        exec hyprctl dispatch exit
        ;;
    *Reboot)
        exec systemctl reboot
        ;;
    *Poweroff)
        exec systemctl poweroff
        ;;
esac
